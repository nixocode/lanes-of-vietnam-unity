# Unity generated. None of this belongs in the repository.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never commit a WebGL build; it is generated and it is large.
WebGLBuild/

*.csproj
*.unityproj
*.sln
*.suo
*.user
*.booproj
*.pidb
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

.vs/
.idea/
.DS_Store

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Captures are outputs of the harness; the measured numbers live in the docs.
captures/*.png
captures/*.json
captures/plants/
captures/soldiers/
!captures/.gitkeep

# Headless sim runner build output.
tools/simcs/bin/
tools/simcs/obj/

# Burst output the WebGL build writes into the project root.
/Data/

# Python environment for the measurement tools (tools/requirements.txt).
tools/.venv/

# Raw downloaded sources (large; re-fetchable). Derived assets live in Assets/.
SourceArt/

# Audio derived from licensed (non-CC0) sources: Sonniss #GameAudioGDC. The
# owner's rule for a public repo — licensed files stay out of git, their .meta
# files go in. Rebuilt by tools/audio/fetch_sonniss.sh + slice_shots.py.
Assets/StreamingAssets/Audio/licensed/*
!Assets/StreamingAssets/Audio/licensed/*.meta

# Licensed source assets (Mixamo, Asset Store, Fab, Sonniss): out of git, .meta in
# (the owner's decision for a public repo, 2026-09-30).
Assets/_Licensed/**
!Assets/_Licensed/**/
!Assets/_Licensed/**/*.meta

# Python's bytecode cache (tools import each other's modules).
__pycache__/
